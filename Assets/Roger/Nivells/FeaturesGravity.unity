      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: abcfe02ca2847804caf9be73c7b8a997, type: 3}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 100
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "The Corgi Engine allows you to define \ncustom gravity, and you can have
    \na different one for each character.\n\n<color=black>Here you have a few examples\nof
    what you can do. Each character has \nits own gravity, and can still live in
    \nthe same world as the others. \nOf course you can set the gravity \non a full
    360\xB0 scale, not just these.\n\nAll these characters are set as players \nand
    bound on Player 1's input, so you \ncan see how it works just by moving your
    \ncharacter (the white one).\n\nNotice there's an option to invert input when\nupside
    down.</color>"
